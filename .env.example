# Copy to .env and fill in values
DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-secret-here"
# Master key for deriving per-borrow stream tokens (32+ bytes, base64)
STREAM_TOKEN_SECRET="generate command: openssl rand -base64 32"

# LOCAL DEV ONLY — password for demo users created by npm run db:seed
# Change this before any shared/staging environment. Never use defaults in production.
SEED_DEMO_PASSWORD="changeme123"
# Must match SEED_DEMO_PASSWORD for one-click demo login buttons (dev mode only)
NEXT_PUBLIC_DEMO_PASSWORD="changeme123"

# PWA is ON in production builds. In local dev it is OFF by default (faster HMR).
# To test install/offline locally, set BOTH and restart the dev server:
# ENABLE_PWA="true"
# NEXT_PUBLIC_ENABLE_PWA="true"

# Force-disable PWA everywhere (including production builds)
# DISABLE_PWA="true"
